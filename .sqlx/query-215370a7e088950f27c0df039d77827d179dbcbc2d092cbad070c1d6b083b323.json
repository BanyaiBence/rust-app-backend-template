  "query": "\n        UPDATE notes\n        SET title = COALESCE($3, title),\n            body = COALESCE($4, body),\n            updated_at = now()\n        WHERE id = $1 AND user_id = $2\n        RETURNING id, user_id, title, body, created_at, updated_at\n        ",
